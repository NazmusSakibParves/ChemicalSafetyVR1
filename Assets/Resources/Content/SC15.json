  "questions": [
    {
      "id": "SC15.Q1",
      "header": {
        "en": "CHEMICAL SAFETY ASSESSMENT TEST",
        "bn": "রাসায়নিক নিরাপত্তা মূল্যায়ন পরীক্ষা"
      },
      "prompt": {
        "en": "Which protective equipment does the SDS recommend for a corrosive liquid like hydrochloric acid?",
        "bn": "হাইড্রোক্লোরিক অ্যাসিডের মতো ক্ষয়কারী তরলের জন্য নিরাপত্তা তথ্যপত্র কোন সুরক্ষা সরঞ্জাম সুপারিশ করে?"
      },
      "options": [
        {
          "id": "A",
          "text": {
            "en": "Safety glasses + cotton gloves",
            "bn": "সেফটি চশমা + সুতির গ্লাভস"
          }
        },
        {
          "id": "B",
          "text": {
            "en": "Goggles + face shield, neoprene gloves, apron",
            "bn": "ফেস শিল্ডসহ গগলস, নিওপ্রিন গ্লাভস, অ্যাপ্রন"
          }
        },
        {
          "id": "C",
          "text": {
            "en": "Normal glasses + cloth mask",
            "bn": "সাধারণ চশমা + কাপড়ের মাস্ক"
          }
        },
        {
          "id": "D",
          "text": {
            "en": "Nitrile gloves only",
            "bn": "শুধু নাইট্রাইল গ্লাভস"
          }
        }
      ],
      "correct": "B",
      "shuffle": true
    },
    {
      "id": "SC15.Q2",
      "header": {
        "en": "CHEMICAL SAFETY ASSESSMENT TEST",
        "bn": "রাসায়নিক নিরাপত্তা মূল্যায়ন পরীক্ষা"
      },
      "prompt": {
        "en": "What to do if hydrochloric acid touches your skin?",
        "bn": "হাইড্রোক্লোরিক অ্যাসিড ত্বকে লাগলে কী করবেন?"
      },
      "options": [
        {
          "id": "A",
          "text": {
            "en": "Apply burn cream and continue",
            "bn": "পোড়ার ক্রিম লাগিয়ে কাজ চালান"
          }
        },
        {
          "id": "B",
          "text": {
            "en": "Flush with water 15+ min, remove clothing, get help",
            "bn": "১৫ মিনিটের বেশি পানিতে ধুয়ে কাপড় খুলুন, সাহায্য নিন"
          }
        },
        {
          "id": "C",
          "text": {
            "en": "Wipe with dry cloth",
            "bn": "শুকনো কাপড়ে মুছুন"
          }
        },
        {
          "id": "D",
          "text": {
            "en": "Rinse briefly, return to work",
            "bn": "অল্প ধুয়ে কাজে ফিরুন"
          }
        }
      ],
      "correct": "B",
      "shuffle": true
    },
    {
      "id": "SC15.Q3",
      "header": {
        "en": "CHEMICAL SAFETY ASSESSMENT TEST",
        "bn": "রাসায়নিক নিরাপত্তা মূল্যায়ন পরীক্ষা"
      },
      "prompt": {
        "en": "At what temperature should hydrochloric acid be stored?",
        "bn": "হাইড্রোক্লোরিক অ্যাসিড কোন তাপমাত্রায় সংরক্ষণ করতে হয়?"
      },
      "options": [
        {
          "id": "A",
          "text": {
            "en": "2 to 8 °C, cold room",
            "bn": "২ থেকে ৮ °সে, ঠান্ডা ঘরে"
          }
        },
        {
          "id": "B",
          "text": {
            "en": "Below 15 °C, cool and dark",
            "bn": "১৫ °সে-এর নিচে, ঠান্ডা ও অন্ধকারে"
          }
        },
        {
          "id": "C",
          "text": {
            "en": "15 to 25 °C, room temperature",
            "bn": "১৫ থেকে ২৫ °সে, ঘরের তাপমাত্রায়"
          }
        },
        {
          "id": "D",
          "text": {
            "en": "In a freezer",
            "bn": "ফ্রিজারে"
          }
        }
      ],
      "correct": "C",
      "shuffle": true
    }
  ]
}