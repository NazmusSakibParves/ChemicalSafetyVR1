  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ChemicalSafety.Presentable.ContainerInspect
  art: {fileID: 11400000, guid: 2e485fadc37c73148a233e5c59bbce75, type: 2}
  chart: {fileID: 1308308102}
  entries:
  - model: {fileID: 289930959}
    title: FLAMMABLE DRUM
    hazard: Flammable liquid (isopropanol). Ignites easily; keep from heat and sparks.
    storage: Flammables compartment
  - model: {fileID: 289930958}
    title: OXIDIZER PROPERTIES
    hazard: Oxidizer (hydrogen peroxide). Feeds fires and reacts with fuels.
    storage: Oxidizers compartment, away from flammables
  - model: {fileID: 289930957}
    title: ACID BOTTLE
    hazard: Corrosive acid (sulfuric). Burns skin, eyes and metal.
    storage: Acids compartment
  - model: {fileID: 289930956}
    title: CLEANER CANISTER
    hazard: General cleaner (surface sanitizer). Causes serious eye irritation.
    storage: General storage
  - model: {fileID: 289930955}
    title: REACTIVE JAR
    hazard: Reactive metal (magnesium powder). Keep dry and away from water and acids.
    storage: General storage, dry shelf
  - model: {fileID: 289930947}
    title: GENERAL CLEANER SPRAY
    hazard: Surface sanitizer. Irritant; avoid eyes and do not mix with other cleaners.
    storage: General storage
  heldHeight: 0.3
  scanMaterial: {fileID: 2100000, guid: f3b954984067a9f4ea633ed29bad873d, type: 2}
